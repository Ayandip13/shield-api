# SecuShield Backend Environment Configuration

# Server Environment
PORT=5000
NODE_ENV=development

# Database Configuration (Production requires explicit cloud/managed MongoDB URI)
MONGODB_URI=mongodb://localhost:27017/security_management

# CORS Configuration (Production requires exact origin e.g. https://yourdomain.com)
CORS_ORIGIN=*

# JWT Configuration (Production MUST specify a secure custom JWT_SECRET)
JWT_SECRET=super_secret_dev_jwt_key_secushield_2026
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Rate Limiting & Proxy Configuration
TRUST_PROXY=true
RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
API_RATE_LIMIT_MAX=300

# Seeding Safety (Set ALLOW_PRODUCTION_SEED=true ONLY if deliberately seeding prod DB)
ALLOW_PRODUCTION_SEED=false
